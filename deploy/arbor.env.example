# =============================================================================
# ARBOR - Variables d'environnement
# Copier ce fichier en .env et adapter les valeurs
# =============================================================================

# --- Application ---
ARBOR_APP_NAME=ARBOR
ARBOR_APP_VERSION=0.1.0
ARBOR_DEBUG=false
# IMPORTANT : Changer cette clé en production (openssl rand -hex 32)
ARBOR_SECRET_KEY=CHANGE-ME-GENERATE-A-RANDOM-KEY
ARBOR_ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# --- Base de données PostgreSQL ---
POSTGRES_USER=arbor
POSTGRES_PASSWORD=arbor_secret
POSTGRES_DB=arbor
ARBOR_DATABASE_URL=postgresql://arbor:arbor_secret@postgres:5432/arbor

# --- Redis ---
ARBOR_REDIS_URL=redis://redis:6379/0

# --- JWT ---
ARBOR_JWT_ALGORITHM=HS256
ARBOR_JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
ARBOR_JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# --- Stockage des fichiers BOM ---
ARBOR_BOM_STORAGE_PATH=/data/bom_storage

# --- SMTP (Notifications email) ---
ARBOR_SMTP_HOST=smtp.example.com
ARBOR_SMTP_PORT=587
ARBOR_SMTP_USER=
ARBOR_SMTP_PASSWORD=
ARBOR_SMTP_FROM=arbor@example.com
ARBOR_SMTP_TLS=true

# --- Feeds de vulnérabilités ---
ARBOR_ONLINE_MODE=true
# Optionnel : clé API NVD pour améliorer le rate limit (https://nvd.nist.gov/developers/request-an-api-key)
ARBOR_NVD_API_KEY=
ARBOR_NVD_SYNC_INTERVAL_HOURS=1
ARBOR_OSV_SYNC_INTERVAL_HOURS=6

# --- Organisation initiale (mono-org MVP) ---
ARBOR_DEFAULT_ORG_NAME=Mon Organisation
ARBOR_DEFAULT_CVSS_THRESHOLD=0.0

# --- Compte administrateur initial ---
ARBOR_ADMIN_EMAIL=admin@arbor.local
# IMPORTANT : Changer ce mot de passe en production
ARBOR_ADMIN_PASSWORD=CHANGE-ME

# --- Rate limiting ---
ARBOR_RATE_LIMIT_PER_MINUTE=60
